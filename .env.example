# ============================================================================
# TANVION ROYALE - Environment Configuration (example values only; NO secrets)
# NEVER commit real secrets. Copy to .env locally or set variables in the
# Vercel / Render dashboards. Real production values live in the secrets manager.

# ============================================================================

# ----------------------------------------------------------------------------
# VERCEL (FRONTEND — apps/web) — REQUIRED in production
# ----------------------------------------------------------------------------
# Base URL of the deployed API (public, not a secret). In Vercel set:
#   NEXT_PUBLIC_API_URL=https://tanvionroyale.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Canonical PUBLIC origin of this API (no trailing slash, no /api/v1).
# The Admin > Partner providers > BigBang panel builds the wallet-callback and
# webhook URLs to register in the BigBang Dashboard from this value, so the
# operator never has to type them by hand. Resolution order in code:
#   API_PUBLIC_URL -> API_ORIGIN -> APP_URL -> RENDER_EXTERNAL_URL
# Render sets RENDER_EXTERNAL_URL automatically.
#   Production: https://tanvionroyale.onrender.com
API_PUBLIC_URL=http://localhost:3000

# Public base URL of the web app itself (no trailing slash). Used for the
# canonical URLs, Open Graph metadata, robots.txt and sitemap.xml — change it
# in this ONE place when a custom production domain is configured. Never a
# secret: NEXT_PUBLIC_* values are visible to the browser by design.
#   Production (canonical): NEXT_PUBLIC_SITE_URL=https://royale.tanvion.com
NEXT_PUBLIC_SITE_URL=https://royale.tanvion.com

# ----------------------------------------------------------------------------
# FIREBASE CONSOLE — Web push notifications (FCM)
# ----------------------------------------------------------------------------
# IMPORTANT — public vs secret values:
#
# VERCEL (apps/web) — PUBLIC Firebase WEB configuration. These come from the
# Firebase Console → Project Settings → Your apps → Web app. They are NOT
# secrets (the Firebase API key is a public identifier, exactly like a Google
# Maps API key — the browser needs it by design):
#   NEXT_PUBLIC_FIREBASE_API_KEY=<Web API Key>
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
#   NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>
#   NEXT_PUBLIC_FIREBASE_VAPID_KEY=<Web Push VAPID public key>
#       (Firebase Console → Project Settings → Cloud Messaging → Web push
#        certificates → VAPID key — the PUBLIC key part only)
# Only when ALL NEXT_PUBLIC_FIREBASE_* values are present does the browser
# register for push. Missing values → FCM browser registration silently
# disabled (in-app notifications still work — they come from Postgres).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# RENDER (apps/api) — SECRET Firebase ADMIN (service account) credentials.
# From Firebase Console → Project Settings → Service accounts → Generate new
# private key (JSON). NEVER publish this file, never put it in a NEXT_PUBLIC_*
# variable, never commit it. FIREBASE_PRIVATE_KEY is the "private_key" field
# (Render may need newlines escaped as \n). Without these the backend records
# notifications normally and marks FCM deliveries SKIPPED (fail-safe — push is
# a delivery optimization, never a business prerequisite).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# RENDER (BACKEND — apps/api) — required variable NAMES (set in dashboard)
# ----------------------------------------------------------------------------
# Public, non-secret values that are safe in render.yaml:
#   CORS_ORIGIN=https://tanvionroyale.vercel.app
#   APP_URL=https://tanvionroyale.vercel.app
#   GOOGLE_CALLBACK_URL=https://tanvionroyale.onrender.com/api/v1/auth/google/callback
#   FACEBOOK_CALLBACK_URL=https://tanvionroyale.onrender.com/api/v1/auth/facebook/callback
#   OAUTH_ALLOWED_REDIRECTS=https://tanvionroyale.vercel.app
# Secret values (set in the Render dashboard ONLY):
#   DATABASE_URL=<PostgreSQL connection string>
#   JWT_SECRET=<64-char random>
#   SESSION_SECRET=<random>
#   ENCRYPTION_KEY=<32-byte key used to encrypt partner provider secrets at rest>
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   FACEBOOK_CLIENT_ID / FACEBOOK_CLIENT_SECRET
#   OPERATOR_PROVIDER=<real partner adapter name; unset/mock => betting fail-safe disabled>
#   PAYMENT_PROVIDER=<real payment adapter name; unset/mock => deposits/withdrawals fail-safe>
#   SMS_PROVIDER=<twilio|vonage|auto; unset/mock in production => SMS delivery fail-safe>
#   SMS_ACCOUNT_SID / SMS_AUTH_TOKEN / SMS_FROM_NUMBER (when SMS_PROVIDER=twilio)
#   SMS_PRIMARY_PROVIDER / SMS_FALLBACK_PROVIDER (when SMS_PROVIDER=auto)
#   SMS_VONAGE_API_KEY / SMS_VONAGE_API_SECRET / SMS_VONAGE_FROM (when SMS_PROVIDER=vonage)
#   The Admin Panel (Admin -> Settings -> SMS provider) can switch the provider;
#     provider CREDENTIALS always stay in these server-side variables.
#   EMAIL_PROVIDER=smtp (unset/mock in production => email delivery fail-safe)
#   SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASSWORD / EMAIL_FROM (when EMAIL_PROVIDER=smtp)
#   FACE_VERIFICATION_PROVIDER=<real biometric adapter name; unset/mock in production => face verification fail-safe>
#   FACE_VERIFICATION_URL / FACE_VERIFICATION_KEY / FACE_VERIFICATION_SECRET
#   LOG_LEVEL=info
#   MASTER_ADMIN_EMAILS=<the fixed master-owner addresses, comma-separated>

# ----------------------------------------------------------------------------
# Local development defaults (never used in production; see per-service logic)
# ----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
WEB_PORT=3100
APP_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:3100

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://tanvionroyale:tanvionroyale@localhost:5432/tanvionroyale?schema=public

# --- Redis (optional; queue jobs) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-64-char-random-string-in-production
JWT_ACCESS_TOKEN_TTL=15m
SESSION_SECRET=change-me-session-secret
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ROTATION=true
PASSWORD_RESET_TTL_MINUTES=30

# --- Master admin allowlist (SUPER_ADMIN bootstrap) ---
# Comma-separated email addresses - the ONLY accounts that may ever hold
# SUPER_ADMIN. This ONE env value is the allowlist used by:
#   * database/scripts/bootstrap-master-admin.ts (creates them directly, without
#     going through customer signup),
#   * database/scripts/promote-admin.ts (refuses every other address),
#   * the API staff-deactivation guard (these accounts can never be
#     deactivated, even by another SUPER_ADMIN).
# Real values are set in the Render dashboard ONLY (render.yaml declares the key
# with sync: false) and are NEVER committed to source. Placeholder shown here.
MASTER_ADMIN_EMAILS=master-admin-one@example.com,master-admin-two@example.com

# --- Encryption key (used for provider secrets at rest; AES-256-GCM) ---
# REQUIRED in production: without it, storing sports-partner credentials is
# rejected with a structured configuration error. Never use the dev default.
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# --- OAuth (server-side; secrets NEVER in NEXT_PUBLIC_*) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# Comma-separated frontend origins allowed to receive the one-time OAuth
# exchange redirect (first entry = default). NEVER a provider redirect URI.

# Production: OAUTH_ALLOWED_REDIRECTS=https://tanvionroyale.vercel.app
OAUTH_ALLOWED_REDIRECTS=http://localhost:3100

# --- SMS / Phone OTP (Twilio or Vonage) ---
# In production without a real provider the OTP flow returns a clear
# "SMS delivery is not configured" error — never a fake success.
#
# PROVIDER SELECTION
#   SMS_PROVIDER=twilio  -> Twilio only
#   SMS_PROVIDER=vonage  -> Vonage only
#   SMS_PROVIDER=auto    -> SMS_PRIMARY_PROVIDER first, then SMS_FALLBACK_PROVIDER
#                           exactly once with the SAME one-time code (no second
#                           OTP is generated, burned or sent)
#   unset / "mock"       -> production fails safely; local development logs only
# The Admin Panel (Admin -> Settings -> SMS provider) can override this value at
# any time; the saved selection then wins and SMS_PROVIDER becomes the fallback
# default. Recommended default: twilio primary, vonage fallback.
#
# CREDENTIALS ARE SERVER-SIDE ONLY
#   Every value below is a SECRET or account identifier. Set them in the Render
#   dashboard (sync: false), never in git and NEVER in a NEXT_PUBLIC_* variable:
#   the browser bundle is public. The admin API only ever reports whether a
#   provider is CONFIGURED, never a SID, key, secret or sender value.
#
# TWILIO (existing, unchanged — the SMS_* names below stay the primary ones)
#   SMS_ACCOUNT_SID=<Twilio Account SID>
#   SMS_AUTH_TOKEN=<Twilio Auth Token>
#   SMS_FROM_NUMBER=<Twilio "From" SENDER value, see below>
#   Optional aliases, used ONLY when the variable above is empty:
#   SMS_TWILIO_ACCOUNT_SID= / SMS_TWILIO_AUTH_TOKEN= / SMS_TWILIO_FROM=
#
# SMS_FROM_NUMBER is the Twilio "From" SENDER value and is deliberately NOT
# restricted to a phone number. Twilio accepts either of these, and which one
# is valid depends on the destination and on what the account has approved:
#   * an E.164 phone number that you own/rented and verified in the Twilio
#     Console, e.g. +1XXXXXXXXXX  (or a Twilio trial number)
#   * an APPROVED Alphanumeric Sender ID, which some destinations require
#     (notably Bangladesh, where a numeric sender may be rejected by the
#     local route) — it must already be registered and approved for the
#     Twilio account.
# The value is passed to Twilio EXACTLY as configured. Nothing here defaults,
# rewrites or invents a sender ID: if Twilio rejects it, the API log line
# "[TwilioSmsCodeSender] Twilio SMS rejected: status=… code=… message=…"
# reports the provider's real reason.
#
# VONAGE (second provider — https://dashboard.nexmo.com/sign-up)
#   SMS_VONAGE_API_KEY=<Vonage API key>
#   SMS_VONAGE_API_SECRET=<Vonage API secret>
#   SMS_VONAGE_FROM=<Vonage "from" sender: a number you own, or an approved
#                     alphanumeric sender ID for destinations that require it>
#   Optional aliases, used ONLY when the variable above is empty:
#   VONAGE_API_KEY= / VONAGE_API_SECRET= / VONAGE_FROM=
#   Vonage is called over its documented SMS HTTP API
#   (POST https://rest.nexmo.com/sms/json) with the SAME, unchanged OTP message
#   Twilio sends. The recipient is always the canonical E.164 number produced
#   by the phone normalizer.
SMS_PROVIDER=
SMS_PRIMARY_PROVIDER=twilio
SMS_FALLBACK_PROVIDER=vonage
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_VONAGE_API_KEY=
SMS_VONAGE_API_SECRET=
SMS_VONAGE_FROM=

# --- Email delivery (SMTP via nodemailer) ---
# Used for the verification-page email OTP (purpose EMAIL_VERIFY), the emailed
# verification link and password-reset emails. Recipients can be any address
# (e.g. user@gmail.com); the SMTP account below is the APPLICATION's sender
# account configured by the owner — it is NOT the recipient's account.
# Production (Render dashboard, NEVER in git or NEXT_PUBLIC_*):
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=<user enters manually, e.g. smtp.gmail.com or smtp.yourdomain.com>
#   SMTP_PORT=587                (or 465)
#   SMTP_SECURE=false            (set true when the provider requires implicit TLS, e.g. port 465)
#   SMTP_USER=<user enters manually>
#   SMTP_PASSWORD=<user enters manually — for Gmail SMTP this is an App Password>
#   EMAIL_FROM="TANVIONROYALE <no-reply@yourdomain.com>"
# In production without this configuration the email OTP flow returns a clear
# "Email delivery is not configured" error — never a fake success.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Paper trading (VIRTUAL simulator — separate from the Wallet) ---
# MARKET_DATA_PROVIDER: "demo" (default) uses a clearly-labelled synthetic
# feed. A real licensed feed plugs in behind MarketDataProvider later; until
# then the simulator must never present fabricated prices as LIVE.
MARKET_DATA_PROVIDER=demo
TRADING_CURRENCY=USD
TRADING_STARTING_BALANCE=1000000
TRADING_MAX_ORDER_QUANTITY=1000000
TRADING_HISTORY_POINTS=30

# --- Face verification ---
# In production without a real provider face verification stays PENDING /
# unavailable and is NEVER auto-granted. Leave unset (or 'mock', development
# only) — production treats both as "not configured" and fails safely.
FACE_VERIFICATION_PROVIDER=
FACE_VERIFICATION_URL=
FACE_VERIFICATION_KEY=
FACE_VERIFICATION_SECRET=

# --- Sports partner (env side) ---
# The partner DESTINATION config (name/baseUrl/deepLinkTemplate/sync status)
# lives in the DB and is managed via the ADMIN API (secrets encrypted at rest; the
# API responses only return masked flags). The API session and sync use the
# operator adapter named here:
OPERATOR_PROVIDER=
OPERATOR_API_URL=https://operator.example.com/api
OPERATOR_API_KEY=
OPERATOR_API_SECRET=
OPERATOR_WEBHOOK_SECRET=

# --- Partner casino (Script.Casino-style) ---
# TWO ENVIRONMENTS, NEVER MIXED: the API process operates in exactly one
# environment declared by PARTNER_CASINO_ENV (sandbox | production) and only
# ever uses the PartnerProvider row whose `environment` matches. Sandbox
# sessions/credentials can never leak into production and vice versa.
# Secrets are server-side only (NEVER NEXT_PUBLIC_*, NEVER logged, NEVER
# returned by any endpoint). Prefer setting them in the Render dashboard;
# the encrypted PartnerProvider DB row is the alternative store.
# Until configured, BIG CASINO / BIG LIVE CASINO honestly report
# "not configured / unavailable" — never fake games.
PARTNER_CASINO_ENV=sandbox
PARTNER_CASINO_PROVIDER=
PARTNER_CASINO_MERCHANT_ID=
PARTNER_CASINO_SECRET=
PARTNER_CASINO_API_VERSION=v1
PARTNER_CASINO_TIMEOUT_MS=10000
PARTNER_CASINO_CACHE_TTL_MS=60000
PARTNER_CASINO_PAGE_SIZE=48
PARTNER_CASINO_PAGE_SIZE_MAX=60
PARTNER_CASINO_MAX_SYNC_PAGES=40
PARTNER_CASINO_MIN_BET_MINOR=1
PARTNER_CASINO_MAX_BET_MINOR=50000000
PARTNER_CASINO_LAUNCH_HOSTS=

# --- Embedded sportsbook in BIG SPORT (WinHouse, SPORTS_IFRAME, wallet Model B) ---
# The provider HOSTS the book and embeds it in BIG SPORT with its own loader
# (`https://iframe.winhouse.bet/embed.js`). TANVION keeps the ONE wallet: the
# provider asks this API for the player's balance (GET /user-data) and reports
# every stake/payout (POST /balance-change), authenticated by the callback
# token + an HMAC-SHA256 signature. No second balance exists anywhere.
#
# TWO ENVIRONMENTS, NEVER MIXED: the API process declares exactly one with
# WINHOUSE_ENV (sandbox | production) and only ever uses the PartnerProvider
# row whose `environment` matches. For the production Render deployment this
# must be explicitly `production`; missing or any other value fails closed and
# can never silently select a provider row.
#
# THREE DIFFERENT CREDENTIALS â€” never interchangeable:
#   WINHOUSE_EMBED_KEY       PUBLIC `ifr_...` iframe key (skin selector, not a
#                            secret; the browser receives it as data-key).
#   WINHOUSE_WALLET_API_KEY  SECRET. HMAC-SHA256 signing key for the
#                            balance-change signatures AND the launch tokens.
#                            Server-side only â€” never sent to the browser.
#   WINHOUSE_CALLBACK_TOKEN  SECRET. Authenticates the provider's wallet
#                            callbacks (?token=) in constant time.
# The two secrets are also storable in the admin panel (Partner providers â†’
# embedded sportsbook), where they are encrypted at rest with AES-256-GCM.
# NEVER put either secret in a NEXT_PUBLIC_* variable.
#
# Wallet base URL to register in the provider's portal (one base only):
#   https://tanvionroyale.onrender.com/api/v1/winhouse
# WinHouse appends /user-data and /balance-change. Store this public value,
# the exact frontend Domain origin, and optional dedicated Server IP in the
# encrypted-secret provider row's allowlisted public config via Admin UI.
# Render shared outbound CIDRs must not be invented or entered without a provider-approved value.
# The current embed.js + data-launch flow does not use the IP-checked /tenant/session call.
# Until configured, BIG SPORT shows no book at all (never a fake one).
WINHOUSE_ENV=sandbox
WINHOUSE_PROVIDER=
WINHOUSE_EMBED_KEY=
WINHOUSE_EMBED_BASE_URL=https://iframe.winhouse.bet
WINHOUSE_WALLET_API_KEY=
WINHOUSE_CALLBACK_TOKEN=
# Launch-token lifetime (ms). Clamped to the provider's documented 10-minute
# maximum; the token is minted server-side on every page load.
WINHOUSE_LAUNCH_TTL_MS=300000
WINHOUSE_TIMEOUT_MS=10000
WINHOUSE_LANG=en
WINHOUSE_THEME=dark
# Height of TANVION's own fixed mobile bottom navigation, passed to the provider
# loader as data-bottom-gap so the book's tab bar/betslip are never covered.
WINHOUSE_BOTTOM_GAP_PX=56
# Desktop frame height handed to the loader (any CSS length).
WINHOUSE_FRAME_HEIGHT=900px

# --- Partner casino (BIG CASINO / BIG LIVE CASINO -> BigBang) ---
# The environment this API process operates in. The resolver only ever uses the
# PartnerProvider row whose `environment` matches, so a sandbox credential can
# never be used in production (or the reverse). Values: sandbox | production.
PARTNER_CASINO_ENV=sandbox
# Outbound budget for an INTERACTIVE provider call (game launch, balance).
PARTNER_CASINO_TIMEOUT_MS=10000
# Outbound budget for a CATALOG page read. A catalog walk is several bounded
# page calls over a multi-thousand-row inventory, so it gets its own, larger
# budget rather than forcing the interactive timeout upward. Never applied
# below PARTNER_CASINO_TIMEOUT_MS.
PARTNER_CASINO_CATALOG_TIMEOUT_MS=60000
# Rows requested per provider page while walking the catalog. The adapter clamps
# this to the provider's documented maximum (BigBang: 5000).
# Keep it BOUNDED. Requesting the provider's whole ~1,860-game catalog in one
# response is what made every production sync abort with
# "BigBang request timed out after 10000ms" against a host that answers a
# `limit=1` probe in well under a second.
PARTNER_CASINO_CATALOG_PAGE_SIZE=500

# --- BigBang per-purpose budgets (public, non-secret) -----------------------
# The BigBang adapter uses a DIFFERENT budget per kind of call, so raising the
# catalog ceiling for a large inventory can never make the admin health check or
# a game launch hang. Unset => falls back to the PARTNER_CASINO_* values above.
#   BIGBANG_HEALTH_TIMEOUT_MS  -> the cheap reachability probe (GET /games?limit=1)
#   BIGBANG_CATALOG_TIMEOUT_MS -> ONE catalog read (a /games page OR /categories).
#                                 This is the budget that stops a slow
#                                 GET /categories from aborting a sync with
#                                 "BigBang request timed out after 10000ms". It is
#                                 clamped to be >= BIGBANG_TIMEOUT_MS.
#   BIGBANG_LAUNCH_TIMEOUT_MS  -> an interactive launch/player call
BIGBANG_HEALTH_TIMEOUT_MS=10000
BIGBANG_CATALOG_TIMEOUT_MS=60000
BIGBANG_LAUNCH_TIMEOUT_MS=10000
# Page size used for PUBLIC catalog reads (what a browser may request).
PARTNER_CASINO_PAGE_SIZE=48
PARTNER_CASINO_PAGE_SIZE_MAX=60
# The credentials are normally read from the AES-256-GCM encrypted
# PartnerProvider row (Admin -> Partner providers), which is the preferred
# store. Set these two ONLY if no encrypted row exists. They are server-only:
# NEVER put either in a NEXT_PUBLIC_* variable, and never commit real values.
PARTNER_CASINO_MERCHANT_ID=
PARTNER_CASINO_SECRET=

# --- Payments (env side) ---
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_URL=https://payments.example.com/api
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
# Shared secret used to verify HmacSha256 payment webhook signatures
# (header: x-webhook-signature over the RAW body; optional x-webhook-timestamp).
# Also used as PAYMENT_PROVIDER_SECRET fallback for gateway webhooks.
PAYMENT_WEBHOOK_SECRET=

# --- Betting / wallet / crash currency policy (server-enforced) ---
# The wallet and betting ledger support exactly these currencies:
#   BDT (default), USD, EUR.
# WALLET_CURRENCY / BETTING_CURRENCY / CRASH_CURRENCY may only be set to one of
# them; anything else is ignored (wallet falls back to BDT). GBP is NOT a
# supported wallet currency.
WALLET_CURRENCY=BDT
BETTING_CURRENCY=BDT
BETTING_MIN_STAKE=100
BETTING_MAX_STAKE=100000
CRASH_MODE=FREE_PLAY
CRASH_CURRENCY=BDT
CRASH_REAL_MONEY_ALLOWED=false

# --- TANVION ROYALE — Plinko + Mines (server-authoritative) ---
# SAFE DEFAULTS. Real money is FAIL-CLOSED: it only ever turns on when ALL of
# these hold at once (see resolveRoyaleRealMoney in royale.config.ts):
#   1. ROYALE_MODE=REAL_MONEY,  2. ROYALE_REAL_MONEY_ALLOWED=true,
#   3. NODE_ENV=production,  4. a real, IMPLEMENTED licensed-operator adapter
#   (IMPLEMENTED_REAL_OPERATOR_ADAPTERS in betting-provider.factory.ts — it is
#   intentionally EMPTY),  5. a configured payment provider for deposits AND
#   withdrawals. Until a genuine operator adapter exists (E1), real money can
#   NEVER be enabled — leave these at the values below. Do NOT set
#   ROYALE_MODE=REAL_MONEY or ROYALE_REAL_MONEY_ALLOWED=true unless every
#   condition above is genuinely satisfied and legally signed off.
ROYALE_MODE=FREE_PLAY
ROYALE_REAL_MONEY_ALLOWED=false
ROYALE_CURRENCY=BDT
# Stakes are integer MINOR UNITS (e.g. poisha for BDT). Bounds are re-validated
# server-side on every drop/start; the client can never widen them.
ROYALE_MIN_STAKE=100
ROYALE_MAX_STAKE=100000
# Target return-to-player in basis points (9900 = 99.00%). Clamped to (0,10000]
# so no payout table can ever target >100% RTP.
ROYALE_RTP_BP=9900
# Kill-switch for both Royale games (false disables them entirely).
ROYALE_GAME_ENABLED=true
# Mines board bounds (mines are always capped at 24 and below the grid size).
ROYALE_MINES_MAX_MINES=10
# Version tag written onto every round for auditability of the RNG algorithm.
ROYALE_ALGORITHM_VERSION=v1
# Minimum age for REAL_MONEY play. Configurable but NEVER lowered below 18 —
# a value under 18 is ignored and the floor of 18 is used instead.
ROYALE_MIN_AGE=18
# Responsible gambling: cooling-off delay (hours) before a limit RAISE or an
# exclusion END becomes effective. Lowering a limit and self-excluding are
# always IMMEDIATE. Keep >= 1 in production (24 = the default).
ROYALE_RG_COOLING_OFF_HOURS=24

# --- KYC (future) ---
KYC_PROVIDER=mock
KYC_PROVIDER_URL=https://kyc.example.com/api
KYC_PROVIDER_KEY=
KYC_PROVIDER_SECRET=

# --- Observability / operational ---
LOG_LEVEL=info
SENTRY_DSN=
WEBHOOK_MAX_AGE_SECONDS=300
WEBHOOK_ALLOWED_IPS=0.0.0.0/0

# ----------------------------------------------------------------------------
# GOOGLE CLOUD CONSOLE (for the deployed API) - OAuth consent + credentials
#   Application home page:  https://royale.tanvion.com
#   Privacy policy:         https://royale.tanvion.com/privacy
#   Terms of service:       https://royale.tanvion.com/terms
#   Authorized JavaScript origins (scheme+host+port only, NO path):
#     https://royale.tanvion.com
#     https://tanvionroyale.vercel.app        (kept during migration)
#     http://localhost:3000                    (dev OAuth client only)
#     http://127.0.0.1:3000                    (dev OAuth client only)
#   Authorized redirect URIs (EXACT, no trailing slash — the API callback,
#   NEVER the frontend origin):
#     https://tanvionroyale.onrender.com/api/v1/auth/google/callback   (production)
#     http://localhost:3111/api/v1/auth/google/callback                (dev, real backend port)
#   Authorized domains:  tanvion.com   (the registrable parent domain only —
#     no scheme/path/port; verify ownership via Google Search Console)
# ----------------------------------------------------------------------------
# FACEBOOK DEVELOPER CONSOLE (for the deployed API)
#   App Domains:   royale.tanvion.com  (+ tanvionroyale.vercel.app during migration)
#   Website URL:   https://royale.tanvion.com
#   Privacy Policy URL:  https://royale.tanvion.com/privacy
