{
  "name": "tanvion-royale",
  "version": "0.1.0",
  "private": true,
  "description": "TANVIONROYALE — professional sportsbook platform (frontend + licensed operator integration).",
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @tanvion-royale/api prisma:generate",
    "db:migrate": "pnpm --filter @tanvion-royale/api prisma:migrate",
    "db:seed": "pnpm --filter @tanvion-royale/api prisma:seed",
    "db:seed:freeplay-user": "pnpm --filter @tanvion-royale/api prisma:seed-freeplay-user",
    "db:seed:admin": "pnpm --filter @tanvion-royale/api prisma:seed-local-admin",
    "db:bootstrap": "pnpm --filter @tanvion-royale/api prisma:bootstrap",
    "dev:local": "node scripts/dev-local.mjs",
    "ports:check": "node scripts/check-ports.mjs",
    "ports:free": "node scripts/check-ports.mjs --kill",
    "sim:royale-ace": "pnpm --filter @tanvion-royale/api sim:royale-ace",
    "sim:tune:royale-ace": "pnpm --filter @tanvion-royale/api sim:tune:royale-ace"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.15",
    "prisma": "5.22.0"
  },
  "engines": {
    "node": ">=20 <25"
  }
}