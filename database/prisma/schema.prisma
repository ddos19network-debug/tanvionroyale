/// real Wallet, so free-play can never be mistaken for money.
model CrashFreePlayWallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(100000) // free-play points only (never money)
  currency  String   @default("FREEPLAY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CrashFreePlayTransaction[]

  @@unique([userId])
}

/// Append-only FREE-PLAY points ledger. Mirrors the real Wallet ledger model:
/// every balance change writes exactly one entry with before/after balances.
model CrashFreePlayTransaction {
  id             String              @id @default(uuid())
  walletId       String
  wallet         CrashFreePlayWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String
  type           CrashFreePlayTxType
  amount         Int // signed points
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String? // 'CRASH_BET' | 'CRASH_SETTLEMENT' | 'SYSTEM'
  referenceId    String?
  idempotencyKey String
  createdAt      DateTime            @default(now())

  @@unique([userId, idempotencyKey])
  @@index([walletId])
  @@index([referenceType, referenceId])
}

