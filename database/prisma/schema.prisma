  @@index([methodId])
}

/// Idempotency log for gateway callbacks. A (provider, eventId) is processed
/// at most once - duplicate webhooks are acknowledged and ignored so a deposit
/// or withdrawal can never be credited/deducted twice.
model PaymentWebhookEvent {
  id             String   @id @default(uuid())
  provider       String
  eventId        String
  type           String
  status         String   @default("RECEIVED")
  reference      String?
  amount         Int?
  currency       String?
  payload        Json?
  signatureValid Boolean  @default(true)
  processedAt    DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
  @@index([status])
  @@index([reference])
}

