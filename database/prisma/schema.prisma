/// (e.g. crash cash-out points). Kept separate from sessions so leaderboards
/// and history can be served without replaying full state.
model GameResult {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSlug  String // free-play engine slug
  score     Int      @default(0) // free-play points, never real money
  outcome   String // WIN | LOSS | VOID (free-play only)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, gameSlug])
  @@index([gameSlug, createdAt])
}

