/// A filled (or rejected/cancelled) virtual market order.
enum TradingOrderStatus {
  NEW
  VALIDATING
  RESERVING
  SUBMITTING
  ACKNOWLEDGED
  PARTIALLY_FILLED
  FILLED
  CANCEL_PENDING
  CANCELLED
  REJECTED
  EXPIRED
  FAILED_RECONCILIATION
}

model TradingOrder {
  id            String             @id @default(uuid())
  accountId     String
  account       TradingAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId  String
  instrument    TradingInstrument  @relation(fields: [instrumentId], references: [id])
  side          TradingOrderSide
  status        TradingOrderStatus
  /// Filled execution price in minor units (null when rejected/cancelled).
  priceFilled   Int?
  quantity      Int // virtual units
  /// Total notional in minor units = quantity * priceFilled (signed per side).
  notional      Int
  /// Reason for rejection (e.g. insufficient virtual balance).
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([instrumentId])
}

/// An open or closed virtual position.
model TradingPosition {
  id            String                @id @default(uuid())
  accountId     String
  account       TradingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId  String
  instrument    TradingInstrument     @relation(fields: [instrumentId], references: [id])
  side          TradingOrderSide
  quantity      Int
  /// Average entry price in minor units.
  avgEntryPrice Int
  status        TradingPositionStatus @default(OPEN)
  /// Realized P&L for CLOSED positions (minor units).
  realizedPnl   Int                   @default(0)
  /// Timestamp of the closing fill (null while OPEN).
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
  @@index([instrumentId])
}

/// Append-only virtual cash ledger for the paper account. Every balance
/// mutation writes exactly one entry in the same DB transaction.
model TradingTransaction {
  id        String                 @id @default(uuid())
  accountId String
  account   TradingAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      TradingTransactionType
  amount    Int // signed minor units
  /// Human-readable reason, e.g. "ACCOUNT_CREDIT", "BUY AAPL", "CLOSE_PNL".
  reason    String
  createdAt DateTime               @default(now())

  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Free-play games (internally developed, clearly NOT real-money gambling).
//
// The catalog tiles on the home/front-end are presentation-only except the
// internally developed free-play games (Sky Rocket crash, Lightning Dice, and
// the paper game collection). These FOR FREE-PLAY ONLY sessions store
// authoritative engine state and the integer score earned. There is NO money,
// wallet movement or odds attached: `score` is free-play points only.
// Real-money gambling lives exclusively in the BettingModule behind the
// licensed-operator gate.
// ---------------------------------------------------------------------------

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

/// One uninterrupted play session of an internally developed free-play game.
/// `state` holds the authoritative engine state (crash multiplier, dice
/// target, rolled values) and is only ever mutated server-side.
model GameSession {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSlug  String // free-play engine slug, e.g. "sky-rocket" | "lightning-dice"
  status    GameSessionStatus @default(ACTIVE)
  state     Json // engine state (serialized, server-authoritative)
  startedAt DateTime          @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, gameSlug])
  @@index([userId, status])
  @@index([gameSlug, status])
}

