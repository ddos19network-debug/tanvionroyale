// any floating-point drift ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â this is the documented odds representation:
//
//   price := /^\d+(\.\d{1,2})?$/  (a decimal odds value, up to 2 dp)
//
// Money (stake / potentialPayout) is stored as integer MINOR UNITS (e.g. pence
// for GBP). Bets carry an immutable odds snapshot per selection so settlement
// never depends on later odds changes.
// ---------------------------------------------------------------------------

enum EventStatus {
  SCHEDULED
  LIVE
  SUSPENDED
  FINISHED
  CANCELLED
}

/// Authoritative routing mode for an event. NATIVE events are handled by the
/// TANVIONROYALE local betting engine; PARTNER events are handled by an external
/// licensed gambling partner (deep-linked server-side).
enum BettingMode {
  NATIVE
  PARTNER
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
}

enum SelectionStatus {
  ACTIVE
  INACTIVE
}

/// Whether a selection (and thus a SINGLE bet) settled as won/lost/void.
enum SelectionResult {
  WIN
  LOSS
  VOID
  PUSH
}

enum BetType {
  SINGLE
  MULTIPLE
}

/// Bet lifecycle. Only the documented transitions are allowed (see
/// docs / betting.idempotency + lifecycle notes in the BettingService).
enum BetStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  SETTLED
  VOID
}

/// A sporting contest / match within a TANVIONROYALE game.
model Event {
  id              String      @id @default(uuid())
  gameId          String
  game            Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  providerEventId String // maps to MockProvider ProviderEvent.externalId
  name            String
  startTime       DateTime
  status          EventStatus @default(SCHEDULED)

  /// Competition/league/tournament this event belongs to (e.g. IPL).
  competitionId     String?
  competition       Competition?     @relation(fields: [competitionId], references: [id])
  /// Team names (denormalized from the provider feed for display).
  homeName          String?
  awayName          String?
  /// Provider-supplied live flag (authoritative from the backend/provider).
  live              Boolean          @default(false)
  /// Authoritative server-side routing: NATIVE events use the TANVIONROYALE bet
  /// slip; PARTNER events redirect to the configured partner provider.
  bettingMode       BettingMode      @default(NATIVE)
  /// Partner's external event id used to build the approved deep link.
  externalEventId   String?
  /// Active partner provider used ONLY when bettingMode = PARTNER.
  partnerProviderId String?
  partnerProvider   PartnerProvider? @relation(fields: [partnerProviderId], references: [id])

  markets Market[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, providerEventId])
  @@index([status])
  @@index([gameId])
  @@index([competitionId])
  @@index([bettingMode])
  @@index([partnerProviderId])
}

/// A bettable market within an event (e.g. "Match Winner", "Total Goals").
model Market {
  id      String       @id @default(uuid())
  eventId String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  status  MarketStatus @default(OPEN)

  selections Selection[]

  @@unique([eventId, name])
  @@index([status])
}

/// A bettable selection inside a market (e.g. "Home" / "Draw" / "Away").
model Selection {
  id                  String          @id @default(uuid())
  marketId            String
  market              Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  name                String
  providerSelectionId String // maps to MockProvider ProviderOdd.selection.externalId
  status              SelectionStatus @default(ACTIVE)

  odds          Odds?
  betSelections BetSelection[]

  @@unique([marketId, providerSelectionId])
  @@index([status])
}

/// The CURRENT price for a selection. Odds are the only mutable input; once a
/// bet is placed the price is frozen in the BetSelection snapshot.
model Odds {
  id          String    @id @default(uuid())
  selectionId String    @unique
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  price       String // decimal string, e.g. "1.85"
  oddsVersion Int       @default(1)
  updatedAt   DateTime  @updatedAt

  @@index([price])
}

/// A placed bet. Provider reference only when the provider accepted it.
/// Idempotency: at most one active bet per (userId, idempotencyKey).
model Bet {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              BetType   @default(SINGLE)
  status            BetStatus @default(PENDING)
  stake             Int // minor units
  potentialPayout   Int // minor units
  currency          String    @default("GBP") // ISO 4217
  providerReference String?
  idempotencyKey    String

  /// Settlement outcome (WIN | LOSS | VOID | PUSH) once the bet is settled.
  result    SelectionResult?
  /// When the bet was settled (null until SETTLED).
  settledAt DateTime?
  /// Payout/refund actually credited to the wallet in minor units (payout for
  /// WIN, stake refund for VOID/PUSH, 0 for LOSS). Null until settled.
  payout    Int?

  selections BetSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([result])
  @@index([createdAt])
}

/// Normalized bet/selection link holding the immutable odds snapshot taken at
/// placement. Names + price are frozen values (never recomputed from live data).
model BetSelection {
  id          String    @id @default(uuid())
  betId       String
  bet         Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  eventName        String
  marketName       String
  selectionName    String
  priceAtPlacement String // decimal string snapshot, e.g. "1.85"
  oddsVersion      Int

  // Settlement outcome for THIS selection snapshot (null until settled).
  result    SelectionResult?
  settledAt DateTime?

  @@unique([betId, selectionId])
  @@index([selectionId])
}

