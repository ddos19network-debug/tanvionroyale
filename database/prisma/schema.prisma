/// serialized by the round row lock + bet row lock + unique betId constraint.
model CrashSettlement {
  id                String                @id @default(uuid())
  roundId           String
  round             CrashRound            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  betId             String                @unique
  bet               CrashBet              @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId            String
  result            CrashSettlementResult
  stake             Int
  cashoutMultiplier Float?
  payout            Int
  transactionId     String?
  idempotencyKey    String
  createdAt         DateTime              @default(now())

  @@index([roundId])
  @@index([userId])
  @@index([userId, createdAt])
}

