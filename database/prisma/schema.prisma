model TradingAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency       String   @default("USD")
  /// Virtual cash balance in minor units (>= 0 unless open positions lock it).
  virtualBalance Int      @default(10000000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders       TradingOrder[]
  positions    TradingPosition[]
  transactions TradingTransaction[]

  @@index([userId])
}

/// A virtual tradable instrument (demo catalogs the instruments).
model TradingInstrument {
  id         String                @id @default(uuid())
  symbol     String                @unique // e.g. "AAPL", "BTCUSD", "EURUSD"
