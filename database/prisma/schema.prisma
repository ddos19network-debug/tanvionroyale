/// created ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â changes always come as a NEW version with a mandatory reason.
model RoyaleAceConfigVersion {
  id Int @id @default(1)

  status           RoyaleAceConfigStatus @default(DRAFT)
  version          Int                   @unique
  /// Human label shown in the admin UI and in the client's info modal.
  name             String
  /// The complete typed config (strips, paytable, ladders, caps, bet levels,
  /// jurisdiction rules).
  configJson       Json
  /// Validation problems found when the row was created (must be empty).
  validationErrors Json?

  /// REQUIRED on create and on every activation (who changed what, and why).
  changeReason String
  createdById  String
  createdBy    User   @relation("RoyaleAceConfigCreatedBy", fields: [createdById], references: [id])

  activatedAt   DateTime?
  activatedById String?
  activatedBy   User?     @relation("RoyaleAceConfigActivatedBy", fields: [activatedById], references: [id])

  createdAt DateTime @default(now())

  simulationReports RoyaleAceSimulationReport[]

  @@index([status])
}

enum RoyaleAceConfigStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// A stored simulation report for a config version. A version with GOLDEN rules
/// (paytable / strip weights) can only be activated when its newest report has
/// `passed = true`, which requires RTP inside tolerance and no max-win breach.
model RoyaleAceSimulationReport {
  id               String                 @id @default(uuid())
  configVersion    Int
  configVersionRef RoyaleAceConfigVersion @relation(fields: [configVersion], references: [version])

  /// Rows simulated for this report.
  spins            Int
  /// Achieved RTP in bp (e.g. 9655 = 96.55%).
  rtpBp            Int
  /// 99% confidence interval for RTP, in bp.
  rtpCiLowBp       Int
  rtpCiHighBp      Int
  /// Target RTP from the config, in bp, and the tolerance used, in bp.
  targetRtpBp      Int
  toleranceBp      Int
  /// Hit frequency (a round that paid anything) in bp.
  hitFrequencyBp   Int
  /// Free-spin trigger rate in bp (rounds that entered the feature).
  triggerRateBp    Int
  /// Retrigger rate in bp (free-spin rounds that extended).
  retriggerRateBp  Int
  /// RTP split, in bp, exactly as the math design specifies.
  baseGameRtpBp    Int
  cascadeRtpBp     Int
  freeSpinRtpBp    Int
  /// Standard deviation of the per-round return (bp), i.e. volatility.
  volatilityBp     Int
  /// Highest observed win in bp of stake.
  maxWinObservedBp Int
  /// Configured max win in bp.
  maxWinCapBp      Int
  /// FALSE when RTP was outside tolerance or the cap was exceeded.
  passed           Boolean
  notes            String?

  createdById String
  createdBy   User     @relation("RoyaleAceReportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([configVersion, createdAt])
}

