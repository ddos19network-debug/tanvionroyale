model Game {
  id          String        @id @default(uuid())
  sportId     String
  sport       Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  name        String
  slug        String        @unique
  description String?
  status      CatalogStatus @default(ACTIVE)
  sortOrder   Int           @default(0)

  availability    GameAvailability?
  providerMapping ProviderMapping?
  events          Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sportId])
  @@index([status])
}

/// Gambling availability. Defaults to non-gambling; gambling must be
/// explicitly enabled by an admin AND backed by an active provider mapping.
model GameAvailability {
  id              String  @id @default(uuid())
  gameId          String  @unique
  game            Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamblingEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gamblingEnabled])
}

/// Maps a TANVIONROYALE game to a provider game/event identifier through the
/// existing operator-integration abstraction (packages/integrations).
model ProviderMapping {
  id             String                @id @default(uuid())
  gameId         String                @unique
  game           Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  providerName   String // e.g. "mock-operator" (see OperatorProviderInterface.name)
  externalGameId String
  status         ProviderMappingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerName, externalGameId])
  @@index([status])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique // sha256 of the opaque token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

