  /// referred user's qualified deposit total.
  referrerBonusPercent Int               @default(0)

  referredBonusType    ReferralBonusType @default(FIXED_AMOUNT)
  /// Minor units when referredBonusType = FIXED_AMOUNT.
  referredBonusAmount  Int               @default(0)
