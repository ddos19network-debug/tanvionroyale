// One User may have several linked identities (PHONE / GOOGLE / FACEBOOK).
// The (provider, providerAccountId) pair is globally unique so one external
// identity can never belong to two accounts.
// ---------------------------------------------------------------------------

enum AuthIdentityProvider {
  PHONE
  GOOGLE
  FACEBOOK
}

model AuthIdentity {
  id                String               @id @default(uuid())
  provider          AuthIdentityProvider
  providerAccountId String
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

