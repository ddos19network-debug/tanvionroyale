/// Append-only qualifying-signal log. `eventKey` is unique, so replaying a
/// webhook or re-running a settlement can never count the same money twice.
model ReferralEvent {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  /// REGISTRATION | DEPOSIT | WAGER
