//                       qualification rule, caps and expiry are admin-controlled.
//
// Money is ALWAYS integer minor units, exactly like every other amount here.
// ============================================================================

/// Lifecycle of one referral relationship.
enum ReferralStatus {
  PENDING // registered, qualification not met yet
  QUALIFIED // qualification rule satisfied, rewards issued
  REJECTED // explicitly rejected by an admin (never silently dropped)
  CANCELLED // referral relationship revoked by an admin (audited, kept)
}

/// Who a reward row pays.
enum ReferralRewardRecipient {
  REFERRER // the user who shared the code
  REFERRED // the new user who signed up through it
}

/// Reward calculation strategy. PERCENTAGE is always bounded by the admin caps
/// so it can never mint unbounded money.
enum ReferralBonusType {
  FIXED_AMOUNT
  PERCENTAGE
}

/// When a referral becomes payable. Chosen by an admin, never by a user.
enum ReferralQualificationRule {
  REGISTRATION // signing up is enough
  VERIFIED_ACCOUNT // a verified email or phone is required too
  MIN_DEPOSIT // a completed deposit of at least `minDepositAmount`
  MIN_WAGER // completed wagers of at least `minWagerAmount`
  DEPOSIT_AND_WAGER // both of the above
}

/// State of one referral reward. Terminal states are never overwritten except
/// through an audited admin adjustment.
enum ReferralRewardStatus {
  PENDING
  QUALIFIED
  PAID
  REJECTED
  CANCELLED
}

/// The immutable "user B was referred by user A through code X" record.
model Referral {
  id                     String         @id @default(uuid())
  referrerUserId         String
  referrer               User           @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  /// UNIQUE => one referrer per referred user, permanently. This is what makes
  /// the relationship immutable: there is physically no second row that could
  /// point at a different referrer, and no update path exists.
  referredUserId         String         @unique
  referred               User           @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  /// The code exactly as submitted at registration (traceability / audit).
  referralCode           String
