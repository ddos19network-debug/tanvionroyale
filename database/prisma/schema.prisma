/// never offered, so no fake progress can ever be shown.
enum AffiliateTargetType {
  QUALIFIED_REFERRALS // referrals that reached Referral.status = QUALIFIED
  SIGNUPS // referred users that registered at all
}

/// Whether a user currently participates in the AFFILIATE PROGRAM.
///
/// This is deliberately NOT derived from `User.referralCode`: owning a referral
/// code is part of the normal referral program and never implies affiliate
/// membership. `ACTIVE` is the ONLY state in which the affiliate link, the
/// affiliate dashboard and affiliate click attribution apply.
enum AffiliateStatus {
  ACTIVE
  INACTIVE
}

model AffiliateMonthlyTarget {
  id String @id @default(uuid())

  /// The affiliate whose target this is. Cascade only removes the target.
  affiliateUserId String
  affiliate       User   @relation(fields: [affiliateUserId], references: [id], onDelete: Cascade)

  /// Calendar month the target applies to (not a date range, so history is
  /// addressable one month at a time and can never be silently overwritten).
  year  Int
  month Int

  targetType  AffiliateTargetType
  /// Whole units of `targetType` (100 = "100 qualified referrals"). 0 is a real,
  /// explicitly-configured value, which is why "no target" is NULL and not 0.
  targetValue Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([affiliateUserId, year, month, targetType])
  @@index([affiliateUserId, year, month])
  @@index([year, month])
}

/// One configurable, ADMIN-EDITABLE section of the /affiliate page.
///
/// SCOPE (GLOBAL vs INDIVIDUAL)
///   This is ONE model with two scopes, never two models. The scope is the
///   nullable `affiliateUserId`:
///     affiliateUserId = NULL  -> GLOBAL. Shows on EVERY active affiliate's
///                                 /affiliate page. Every row that existed
///                                 before individual scope existed is NULL and
///                                 therefore stays global forever.
///     affiliateUserId = <id>  -> INDIVIDUAL. Shows ONLY on that one ACTIVE
///                                 affiliate's /affiliate page and on nobody
///                                 else's. The API derives and verifies this
///                                 value server-side; a browser can never
///                                 choose it.
///   The key is the stable `User.id` (= `AffiliateProfile.userId`), never the
///   referral code: a referral code belongs to the REFERRAL program and is not
///   an identity.
///
/// ORDERING
///   `sortOrder` is independent PER SCOPE. Reordering Affiliate A's blocks can
///   therefore never renumber global content or Affiliate B's content, because
///   the two composite indexes below are both prefixed by `affiliateUserId`.
///
/// SECURITY: a block stores DATA, never code. `type` is a closed enum the API
/// validates; `body` is plain text rendered as text; `imageUrl` is validated
/// server-side against an https-only allow-list. There is no field that can
/// hold JavaScript, an event handler, a style block or raw HTML, so nothing
/// stored here can execute ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â and the admin scope rule is the same for a
/// GLOBAL block and an INDIVIDUAL one.
model AffiliateContentBlock {
  id String @id @default(uuid())

  /// Scope discriminator. NULL = GLOBAL (every active affiliate), a user id =
  /// INDIVIDUAL (that one active affiliate only). The API only ever sets it
  /// from the URL param after verifying an ACTIVE `AffiliateProfile`.
  affiliateUserId String?
  affiliateUser   User?   @relation("AffiliateContentBlockAffiliateUser", fields: [affiliateUserId], references: [id], onDelete: Cascade)

  /// Stable key used for ordering/debugging; not unique (an admin may re-create).
  key String

  /// Closed set of renderable block types. The frontend maps each one to a
  /// pre-built, safe component; an unknown value is refused by the API.
  type String

  title    String?
  subtitle String?
  /// Plain text (paragraphs split on blank line). Rendered as text, never HTML.
  body     String?
  /// Item list for FAQ / HOW_IT_WORKS / BENEFITS blocks ("Question|Answer" per
  /// line for FAQ, one bullet per line otherwise).
  items    String?
  /// https-only, allow-listed image reference. Never a data: or javascript: URL.
  imageUrl String?
  ctaText  String?
  /// https-only same-site/allow-listed link target. Empty = no button.
  ctaUrl   String?

  /// Manual ordering. Admin reordering rewrites sortOrder; there is no
  /// drag-and-drop dependency and the order is always an integer.
  sortOrder Int     @default(0)
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  /// Existing GLOBAL read path (scope + enabled + order), unchanged.
  @@index([isEnabled, sortOrder])
  /// Per-affiliate render path: one affiliate's enabled blocks in order. Both
  /// indexes are prefixed by `affiliateUserId` so an individual read/reorder is
  /// a tight range scan and can never interleave with another scope's order.
  @@index([affiliateUserId, isEnabled, sortOrder])
  @@index([affiliateUserId, sortOrder])
}

/// Membership in the AFFILIATE PROGRAM, as opposed to the referral program.
///
/// WHY A SEPARATE MODEL
///   Every registered user already owns a `User.referralCode` and may use the
///   normal referral system. That must NOT make them an affiliate. Affiliate
///   participation is opt-in, so it needs its own row: this model is created
///   ONLY by an explicit activation, is UNIQUE per user (activation is
///   idempotent and can never produce a second profile), and an admin can turn
///   it off and on again without touching a single referral, reward, wallet or
///   ledger row.
///
/// SAFE URL: `promotionUrl` is validated server-side against the same
/// https-only allow-list the affiliate content blocks use, so a stored channel
/// link can never carry `javascript:` or `data:`.
model AffiliateProfile {
  id String @id @default(uuid())

  /// UNIQUE: one profile per user, ever. This is the idempotency guarantee for
  /// activation and the reason a deactivated affiliate can be REACTIVATED on
  /// the same row instead of accumulating profiles.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ACTIVE = affiliate link / dashboard / click analytics apply.
  /// INACTIVE = deactivated (by the user or by an admin); the referral system,
  /// the referral code and all history are untouched.
  status AffiliateStatus @default(ACTIVE)

  /// Where the affiliate promotes (closed set enforced by the API DTO).
  promotionMethod String?

  /// https:// or a site-relative path. Never a data:/javascript: URL.
  promotionUrl String?

  /// "How will you promote TANVIONROYALE?" ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â free text, no HTML.
  description String?

  /// When the affiliate agreement was accepted. Required for activation, so it
  /// is never null on an existing row.
  termsAcceptedAt DateTime

  /// First activation, then preserved across deactivate/reactivate cycles.
  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, activatedAt])
}

// ============================================================================
// SMS DELIVERY PROVIDER SELECTION (admin-controlled, singleton row id = 1)
//
// WHAT THIS STORES
//   ONLY which SMS provider delivers the one-time codes (Twilio, Vonage, or an
//   automatic primary -> fallback chain). It is the same "singleton settings
//   row the admin panel reads and writes" mechanism the referral program uses.
//
// WHAT THIS NEVER STORES
//   NO credential of any kind. There is no API key, no API secret, no Account
//   SID, no Auth Token and no sender number column here, and none is ever added
//   implicitly. Provider credentials stay in the server/Render environment
//   variables, so this table can never leak a secret through the admin API, a
//   backup, a replica or a log line.
//
//   The admin API therefore exposes `twilio.configured` / `vonage.configured`
//   booleans only - the frontend never receives a provider credential.
// ============================================================================

/// The concrete SMS providers the platform can deliver OTPs through.
enum SmsProviderName {
  TWILIO
  VONAGE
}

