model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // LOGIN_SUCCESS | LOGIN_FAILURE | LOCKOUT | ...
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Auth tokens (email verification, password reset). Only hashes are stored.
// ---------------------------------------------------------------------------

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Sports / Games catalog (Phase 4)
// ---------------------------------------------------------------------------

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProviderMappingStatus {
  ACTIVE
  INACTIVE
}

/// HOW TANVION integrates with a PartnerProvider.
///
///   SPORTS_API         server-side sports/odds API + server-resolved deep links
///                      (the pre-existing sports integration; a NULL
///                      PartnerProvider.integrationType means exactly this).
///   SPORTS_IFRAME      the provider's own sportsbook is EMBEDDED in BIG SPORT
///                      through its loader (e.g. WinHouse Model B seamless
///                      wallet). There is no per-event deep link and no fake
///                      sports/odds data in TANVION.
///   CASINO_API         server-side casino catalog/launch API (see the casino
///                      module and productTypes, which drive that integration).
///   LIVE_CASINO_API    server-side live-dealer catalog/launch API (same).
///   CASINO_AGGREGATOR  external B2B casino/game aggregator (e.g. BigBang) with
///                      server-to-server catalog, launch, and seamless wallet.
enum PartnerIntegrationType {
  SPORTS_API
  SPORTS_IFRAME
  CASINO_API
  LIVE_CASINO_API
  CASINO_AGGREGATOR
}

model Sport {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  icon         String? // icon/image reference
  status       CatalogStatus @default(ACTIVE)
  sortOrder    Int           @default(0)
  games        Game[]
  competitions Competition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

