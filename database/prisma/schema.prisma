  /// deep link: its content is served by the provider's own book.
  deepLinkTemplate     String // e.g. /sport/{sportSlug}/event/{externalEventId}
  status               ProviderMappingStatus   @default(ACTIVE)
  // --- Phase 16 admin configuration (secrets are encrypted at rest) ---
  apiKeyEnc            String? // AES-256-GCM encrypted API key (never raw)
  apiSecretEnc         String? // AES-256-GCM encrypted API secret (never raw)
  authMode             String? // e.g. "api-key" | "basic" | "none"
  apiVersion           String?
