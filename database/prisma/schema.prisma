/// One authoritative crash round. The crash point is predetermined by the
/// seed commitment BEFORE betting opens and stays immutable once revealed.
model CrashRound {
  id          String           @id @default(uuid())
  gameSlug    String           @default("sky-rocket")
  mode        CrashGameMode    @default(FREE_PLAY)
  status      CrashRoundStatus @default(CREATED)
  roundNumber Int

  // Provably-fair commitment.
  serverSeedHash    String  @default("") // commitment published before betting opens
  serverSeed        String? // revealed ONLY after the round crashes
  /// Encrypted-at-rest copy of the server seed (AES-256-GCM via
  /// encryptSecret/decryptSecret). Lets a restarted server resume the round's
  /// pre-determined crash point without ever persisting it in plaintext or
  /// exposing it to clients before the round crashes.
  crashPointSeedEnc String?
  clientSeed        String
  nonce             Int     @default(1)
  algorithmVersion  String  @default("v1")

  /// Operator-configured sequence fields (all server-only until the crash).
  /// crashSource distinguishes seed-derived rounds from sequence rounds;
  /// crashPointConfigured is the predetermined multiplier consumed from the
  /// sequence ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â NEVER exposed through any API view before the round crashes.
  crashSource          CrashPointSource   @default(PROVABLY_FAIR)
  sequenceMode         CrashSequenceMode?
  sequenceIndex        Int?
  crashPointConfigured Float?

  /// Server-controlled clocks (epoch ms timestamps).
  startAt        DateTime
  bettingCloseAt DateTime
  crashAt        DateTime?

  /// Pre-determined crash multiplier (revealed when the round crashes).
  crashMultiplier Float?
  crashedAt       DateTime?
  settledAt       DateTime?
  /// When betting was closed (status RUNNING implied). Kept for auditing.
  bettingClosedAt DateTime?
  createdAt       DateTime  @default(now())

  bets        CrashBet[]
  settlements CrashSettlement[]

  @@unique([gameSlug, roundNumber])
  @@index([status])
  @@index([mode])
  @@index([startAt])
}

/// A player bet on a crash round. Stake is reserved/debited authoritatively:
///  - FREE_PLAY: points debited from the user's CrashFreePlayWallet.
///  - REAL_MONEY: WalletService.reserveStake (available -> locked), then the
///    reservation is captured/refunded on settlement.
/// A unique (userId, idempotencyKey) makes retries idempotent (one bet only).
model CrashBet {
  id                String         @id @default(uuid())
  roundId           String
  round             CrashRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode              CrashGameMode  @default(FREE_PLAY)
  stake             Int // minor units for REAL_MONEY, free-play points for FREE_PLAY
  currency          String         @default("FREEPLAY") // ISO 4217 for REAL_MONEY
  status            CrashBetStatus @default(ACTIVE)
  cashoutMultiplier Float?
  payout            Int?
  transactionId     String? // wallet transaction id (REAL_MONEY) or free-play tx id
  idempotencyKey    String
  placedAt          DateTime       @default(now())
  cashoutAt         DateTime?
  settledAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  settlement CrashSettlement?

  @@unique([userId, idempotencyKey])
  @@index([roundId])
  @@index([roundId, status])
  @@index([userId])
  @@index([userId, createdAt])
}

/// One settlement per bet (CrashBet.settlement is 1:1 via the unique betId).
