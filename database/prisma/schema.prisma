/// /admin/crash endpoints (audited). Player-facing APIs expose only the
/// already-consumed position (mode + index), never upcoming multipliers.
model CrashSequenceState {
  id       String @id @default(uuid())
  gameSlug String @unique @default("sky-rocket")

  /// Current phase of the sequence state machine.
