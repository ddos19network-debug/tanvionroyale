/// Singleton admin configuration of the SMS/OTP delivery provider (row id = 1).
model SmsProviderSettings {
  id Int @id @default(1)

  /// Which provider delivers the codes. AUTO = primary, then fallback once.
  smsProvider SmsProviderMode @default(TWILIO)

  /// Tried FIRST in AUTO mode. Ignored in single-provider mode.
  primarySmsProvider SmsProviderName @default(TWILIO)

  /// Tried ONCE after the primary fails in AUTO mode. Never equal to the
  /// primary (the service repairs that combination, so a failure is never
  /// retried against the provider that just failed).
  fallbackSmsProvider SmsProviderName @default(VONAGE)

  /// Admin audit trail for this setting. Holds the admin user id, never a
  /// credential: the value stored is the provider SELECTION only.
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([smsProvider])
}

