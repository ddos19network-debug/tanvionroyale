// Wallet / Transactions (Phase 6) ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¯ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¿ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â½ additive, double-entry foundation.
// All balances and amounts are integer MINOR UNITS (e.g. pence for GBP).
// No card numbers, CVVs, bank or payment credentials are ever stored.
// ---------------------------------------------------------------------------

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  ADJUSTMENT
  /// A referral reward credited to a beneficiary. It moves through the SAME
  /// WalletService ledger engine as every other amount (wallet row lock + this
  /// transaction + a LedgerEntry), so a referral bonus is real, auditable money
  /// and never a silent `balance +=` edit.
  REFERRAL_BONUS
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

/// One wallet per (user, currency). Balances in minor units; the application
/// only ever mutates them inside WalletService.applyMutation under a row lock,
/// together with a LedgerEntry. availableBalance is never allowed to go
/// negative. There is deliberately no raw "setBalance" path.
model Wallet {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         String       @default("BDT") // ISO 4217
  availableBalance Int          @default(0) // minor units, >= 0
  lockedBalance    Int          @default(0) // minor units, >= 0
  status           WalletStatus @default(ACTIVE)

  transactions  WalletTransaction[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
  @@index([status])
}

/// One financial mutation request. Idempotency: at most one transaction per
/// (userId, idempotencyKey) ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¯ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¿ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â½ duplicates return the original row.
model WalletTransaction {
  id             String                  @id @default(uuid())
  walletId       String
  wallet         Wallet                  @relation(fields: [walletId], references: [id])
  userId         String // denormalized for ownership checks + unique idempotency
  type           WalletTransactionType
  status         WalletTransactionStatus @default(PENDING)
  /// Signed minor units: positive credits (DEPOSIT, BET_PAYOUT, ...),
  /// negative debits (WITHDRAWAL, BET_STAKE, ...).
  amount         Int
  currency       String
  /// Provider reference (e.g. mock-tx-...) once the provider accepted it.
  reference      String?
  failureReason  String?
  idempotencyKey String

  ledgerEntries        LedgerEntry[]
  /// Casino (partner) movements mapped onto this ledger transaction.
  casinoTransactions   CasinoTransaction[]
  /// Embedded sportsbook (WinHouse) movements mapped onto this ledger
  /// transaction. One wallet, one ledger ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â the provider never owns a balance.
  winhouseTransactions WinHouseTransaction[]
  /// BigBang movements mapped onto the same canonical ledger.
  bigbangTransactions  BigBangTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Append-only ledger. Every balance change writes exactly one entry in the
/// same DB transaction as the balance update, recording previous/resulting
/// available+locked balances. Entries are NEVER updated or deleted.
model LedgerEntry {
  id              String            @id @default(uuid())
  walletId        String
  wallet          Wallet            @relation(fields: [walletId], references: [id])
  transactionId   String
  transaction     WalletTransaction @relation(fields: [transactionId], references: [id])
  direction       LedgerDirection
  amount          Int // positive minor units
  availableBefore Int
  availableAfter  Int
  lockedBefore    Int
  lockedAfter     Int
  /// Human-readable reason, e.g. "DEPOSIT_COMPLETED", "WITHDRAWAL_LOCK".
  reason          String

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Manual payment methods + manual deposit requests (BDT/USD).
//
// Admin-configured manual channels (bKash, Nagad, Bank Transfer, Card...).
// The user pays externally and submits a PENDING request with the provider
// transaction reference (and optional payment proof). The wallet is credited
// ONLY after an admin approval, exactly once, through the WalletTransaction
// ledger (unique idempotencyKey `manual-dep:{requestId}`).
// Amounts are integer minor units, currency explicit per request.
// ---------------------------------------------------------------------------

enum PaymentMethodType {
  MANUAL
  GATEWAY
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PaymentGatewayStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ManualDepositStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model PaymentMethod {
  id                  String              @id @default(uuid())
  code                String              @unique // bkash | nagad | bank | card | ...
  displayName         String
  type                PaymentMethodType   @default(MANUAL)
  status              PaymentMethodStatus @default(ACTIVE)
  /// ISO 4217 codes this method accepts, e.g. ["BDT", "USD"].
  supportedCurrencies String[]            @default([])
  depositEnabled      Boolean             @default(true)
  withdrawalEnabled   Boolean             @default(false)

  // Manual payment instructions (shown only while ACTIVE).
  accountNumber String?
  accountName   String?
  bankName      String?
  branch        String?
  routingNumber String?
  instructions  String?

  // Limits in minor units for the currencies configured (0 = unset/no max).
  minDeposit    Int @default(0)
  maxDeposit    Int @default(0)
  minWithdrawal Int @default(0)
  maxWithdrawal Int @default(0)

  requireTransactionId Boolean @default(true)
  requireProof         Boolean @default(false)
  sortOrder            Int     @default(0)

  deposits           ManualDepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  gatewayConfigId    String?
  gatewayConfig      PaymentGatewayConfig?  @relation(fields: [gatewayConfigId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([gatewayConfigId])
}

