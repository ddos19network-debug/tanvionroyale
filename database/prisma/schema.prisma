// ============================================================================
// TANVION ROYALE - Notifications (in-app + Firebase Cloud Messaging push).
//
// PostgreSQL remains the SOURCE OF TRUTH for notification history, read
// state, recipients and auditability; Firebase Cloud Messaging (FCM) is ONLY
// the push DELIVERY provider. No secrets are stored here (device tokens are
// public registration identifiers; the Firebase service-account key lives
// exclusively in backend environment variables).
//
// Idempotency: every automatic (business-event) notification carries a
// `dedupeKey` reference, e.g. `deposit-approved:{requestId}` or
// `bet-settlement:{betId}:WIN`. The (dedupeKey, recipientUserId) unique
// constraint makes a retried event NEVER create a duplicate row or a
// duplicate push (NULL dedupeKey rows are unaffected, which is what manual
// admin broadcasts use).
// ============================================================================

/// Real business events + admin broadcast categories.
enum NotificationType {
  // --- Automatic user notifications (real backend operations) ---
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_COMPLETED
  BET_WON
  BET_LOST
  // --- Referral program (real, audited wallet credits) ---
  /// A user signed up through the recipient's referral code.
  REFERRAL_JOINED
  /// A referred user satisfied the admin-configured qualification rule.
  REFERRAL_QUALIFIED
  /// A referral reward was credited to the recipient's wallet.
  REFERRAL_BONUS_CREDITED
  // --- Automatic admin/operational notifications ---
  NEW_DEPOSIT_REQUEST
  NEW_WITHDRAWAL_REQUEST
  NEW_USER_REGISTRATION
  SECURITY_ALERT
  // --- Support / Live Chat ---
  SUPPORT_MESSAGE // user posted a message in Live Chat (audience: ADMIN)
  SUPPORT_REPLY // admin replied in Live Chat (audience: USER)
  // --- Admin manual broadcast types ---
  SYSTEM_ANNOUNCEMENT
  PROMOTION
  GENERAL
}

/// Whether the notification is a customer notification or an admin-panel one.
enum NotificationAudience {
  USER
  ADMIN
}

/// One notification for one recipient. Read state is authoritative here.
model Notification {
  id              String               @id @default(uuid())
  /// Owner of the notification (users AND admins are both User rows).
  recipientUserId String
  audience        NotificationAudience @default(USER)
  type            NotificationType
  title           String
  message         String
  /// Server-set payload (amounts, references). NEVER secrets, never raw HTML.
  data            Json?
  /// Server-set, ALLOWLISTED in-app route (e.g. /wallet). Never a
  /// client-supplied or arbitrary external URL.
  actionUrl       String?
  /// Idempotency reference, e.g. deposit-approved:{id}. NULL for manual
  /// broadcasts (unique constraints ignore NULLs).
  dedupeKey       String?
  isRead          Boolean              @default(false)
  readAt          DateTime?

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dedupeKey, recipientUserId])
  @@index([recipientUserId, isRead])
  @@index([recipientUserId, audience, createdAt])
  @@index([type, createdAt])
}

/// One registered browser/device per user (a user can have several: desktop
/// Chrome, mobile Chrome, ...). The FCM token is a public registration
/// identifier - never a secret. Stale/invalid tokens are marked inactive
/// (never repeatedly sent to) instead of deleted, keeping history intact.
model NotificationDevice {
  id         String   @id @default(uuid())
  userId     String
  /// Delivery provider. Only "fcm" exists today; the column future-proofs
  /// the registration against additional providers.
  provider   String   @default("fcm")
  token      String
  platform   String? // web | android | ios
  browser    String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, token])
  @@index([userId, isActive])
}

/// Per-device push delivery outcome (retry/dead-letter visibility). A push
/// failure NEVER rolls back the business operation that created the
/// notification - the row stays FAILED for later retry.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // push not configured (e.g. dev without Firebase credentials)
  INVALID_TOKEN // FCM says the registration is stale - device deactivated
}

model NotificationDelivery {
  id             String                     @id @default(uuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceId       String
  device         NotificationDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String? // truncated, never credentials or full tokens
  sentAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, deviceId])
}

