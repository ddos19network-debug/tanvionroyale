/// Free-play slot game round (Games #4 to #13).
/// One round per spin; pre-derived server-authoritatively.
model FreePlaySlotRound {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSlug        String
  clientRequestId String
  stake           Int
  totalPayBp      Int
  payout          Int
  capped          Boolean  @default(false)
  outcome         Json
  createdAt       DateTime @default(now())

  @@unique([userId, clientRequestId])
  @@index([userId, gameSlug, createdAt])
}
