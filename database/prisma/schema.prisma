/// launch, the deterministic id is reused.
model CasinoSession {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId        String
  provider          PartnerProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  casinoGameId      String
  game              CasinoGame          @relation(fields: [casinoGameId], references: [id], onDelete: Cascade)
  externalGameId    String
  providerPlayerId  String
  providerSessionId String?
  providerRoundId   String?
  currency          String
  environment       String
  demo              Boolean             @default(false)
  status            CasinoSessionStatus @default(ACTIVE)

  transactions        CasinoTransaction[]
  bigbangTransactions BigBangTransaction[]
  launchedAt          DateTime             @default(now())
  closedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId, casinoGameId])
  @@index([userId, status])
  @@index([providerId, providerPlayerId])
  @@index([providerId, providerSessionId])
}

/// Maps a provider wallet movement onto the TANVION ledger so callbacks are
/// exactly-once and fully reconcilable. `walletTransactionId` points at the
/// single authoritative ledger movement (one wallet, no partner balance).
model CasinoTransaction {
  id                     String                  @id @default(uuid())
  providerId             String
  provider               PartnerProvider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId              String?
  session                CasinoSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  externalTransactionId  String
  kind                   CasinoTransactionKind
  status                 CasinoTransactionStatus @default(APPLIED)
  /// Signed minor units: BET/ROLLBACK negative, WIN/REFUND positive.
  amount                 Int
  currency               String
  externalRoundId        String?
  /// Provider request nonce (replay protection). Unique per provider.
  nonce                  String?
  walletTransactionId    String?
  walletTransaction      WalletTransaction?      @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  /// Provider transaction this refund/rollback refers to.
  referenceTransactionId String?
  reason                 String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([providerId, externalTransactionId, kind])
  @@unique([providerId, nonce])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([kind, status])
}

/// One BigBang seamless-wallet movement mapped onto the canonical TANVION
/// ledger. This is provider reconciliation metadata, never a second balance.
/// `transactionId` is BigBang's idempotency identity and is unique per row.
model BigBangTransaction {
  id                  String             @id @default(uuid())
  providerId          String
  provider            PartnerProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId           String?
  session             CasinoSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  transactionId       String
  /// Signed minor units: negative = bet/debit, positive = win/credit.
  amountMinor         Int
  /// Exact amount literal received from BigBang, retained for HMAC forensics.
  amountWire          String
  currency            String
  game                String
  gameCategory        String
  /// Informational BigBang game id from the callback (not used as idempotency).
  gameId              String?
  /// Informational provider slug from the callback (not the PartnerProvider row id).
  providerExternalId  String?
  roundId             String?
  roundType           String?
  roundEnd            Boolean?
  payloadHash         String
  balanceBefore       Int
  balanceAfter        Int
  walletTransactionId String?
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  environment         String?
  /// True only for the provider's documented synthetic sandbox callback traffic.
  sandbox             Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([providerId, transactionId])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([roundId])
}

