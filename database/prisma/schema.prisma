/// Lifecycle of a Royale Ace round.
enum RoyaleAceRoundStatus {
  /// The round was created but not settled yet (kept only until the settling
  /// transaction commits; a crash in between is recovered by the reconciler).
  ACTIVE
  /// Settled: stake captured, win credited (may be zero), ledger + audit written.
  SETTLED
  /// Voided by an admin with a reason: the stake is refunded and nothing is
  /// ever credited from a voided round.
  VOIDED
}

