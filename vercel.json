{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rootDirectory": "apps/web",
  "framework": "nextjs",
  "installCommand": "rm -rf ../../node_modules ../../apps/*/node_modules ../../packages/*/node_modules && cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@tanvion-royale/web..."
}