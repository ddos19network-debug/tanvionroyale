# Dependencies
node_modules/
.pnpm-store/
*.local

# Env files — never commit secrets
.env
.env.*
!.env.example

# Build outputs
dist/
build/
.next/
out/
coverage/
.turbo/
.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test artifacts
*.tsbuildinfo
.tmp/

# Prisma
apps/api/prisma/*.db
database/prisma/*.db
# Generated Prisma client is compiled into the API and never committed
apps/api/src/generated/
# Stable native query-engine copies synced by apps/api/prisma-copy-binary.cjs
apps/api/prisma-engine/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Docker — don't commit local dev volumes / sensitive provider config maps
infra/docker/data/

# Misc
.secrets/
keys/
*.pem
# Local scratch / tooling output (test-fix session)
_backup/
.tmp-helpers/
typecheck-*.txt
bootstrap-*.txt
e2e-*.txt
*.tmp.*
drift.sql
