{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@tanvion-royale/types": ["../../packages/types/src"],
      "@tanvion-royale/config": ["../../packages/config/src"],
      "@tanvion-royale/integrations": ["../../packages/integrations/src"],
      "@tanvion-royale/validation": ["../../packages/validation/src"]
    }
  },
  "include": ["src"]
}