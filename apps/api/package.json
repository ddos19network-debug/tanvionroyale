{
  "name": "@tanvion-royale/api",
  "version": "0.1.0",
  "private": true,
  "description": "TANVIONROYALE NestJS API — REST + WebSocket backend.",
  "scripts": {
    "prebuild": "node rm-dist.cjs && pnpm --filter @tanvion-royale/integrations... --filter @tanvion-royale/config --filter @tanvion-royale/validation run build",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate --schema ../../database/prisma/schema.prisma && node prisma-copy-binary.cjs",
    "prisma:migrate": "prisma migrate dev --schema ../../database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../../database/prisma/schema.prisma",
    "prisma:migrate:deploy:strict": "prisma migrate deploy --schema ../../database/prisma/schema.prisma && node ../../scripts/verify-migrations.cjs",
    "prisma:migrate:status": "prisma migrate status --schema ../../database/prisma/schema.prisma",
    "prisma:seed": "ts-node ../../database/scripts/seed.ts",
    "prisma:seed-freeplay-user": "ts-node ../../database/scripts/seed-freeplay-user.ts",
    "prisma:seed-local-admin": "ts-node ../../database/scripts/seed-local-admin.ts",
    "prisma:bootstrap": "ts-node ../../database/scripts/bootstrap-catalog.ts",
    "prisma:seed-roles": "ts-node ../../database/scripts/seed-roles.ts",
    "promote-admin": "ts-node ../../database/scripts/promote-admin.ts",
    "sim:royale-ace": "ts-node -r tsconfig-paths/register src/modules/royale/ace/ace-sim.cli.ts",
    "sim:tune:royale-ace": "ts-node -r tsconfig-paths/register src/modules/royale/ace/ace-tune.ts",
    "slots:sim": "ts-node -r tsconfig-paths/register src/modules/games/slots/slot-sim.cli.ts",
    "slots:tune": "ts-node -r tsconfig-paths/register src/modules/games/slots/slot-tune.cli.ts",
    "audit-account-domains": "ts-node ../../database/scripts/audit-account-domains.ts",
    "db:setup": "pnpm prisma:generate && pnpm prisma:migrate",
    "postinstall": "prisma generate --schema ../../database/prisma/schema.prisma && node prisma-copy-binary.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "6.2.1",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "5.22.0",
    "@tanvion-royale/config": "workspace:*",
    "@tanvion-royale/integrations": "workspace:*",
    "@tanvion-royale/types": "workspace:*",
    "@tanvion-royale/validation": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.22.1",
    "firebase-admin": "^14.4.0",
    "helmet": "^7.1.0",
    "nodemailer": "6.9.16",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "6.4.16",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}